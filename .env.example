# Copier ce fichier en .env et remplir les valeurs.
# Le .env surcharge config.yaml (les valeurs ici prennent
# priorité sauf si elles sont vides).
# Note: le .env utilise le format KEY=VALUE simple, sans
# guillemet, sans expansion de variables. Commentez les
# lignes inutilisées avec #.

# ── OMDb ─────────────────────────────────────────────────
# 1 clé gratuite par compte (1000 req/jour/clé) sur
# https://www.omdbapi.com/apikey.aspx
# Plusieurs clés séparées par virgule: rotation automatique
# quand une clé atteint la limite.
OMDB_KEYS=your_key1,your_key2,your_key3

# ── Radarr ────────────────────────────────────────────────
# API key: Radarr → Settings → General → API Key
RADARR_API_KEY=your_radarr_api_key
# URL: include /api/v3, pas de slash final
RADARR_URL=http://localhost:7878/api/v3
# Root folder: Radarr → Settings → Media Management → Root Folders
ROOT_FOLDER=/movies

# Quality profile: Radarr → Settings → Profiles → colonne ID
QUALITY_PROFILE_ID=6
# When Radarr starts searching: announced / inCinemas / released
MINIMUM_AVAILABILITY=announced

# ── LLM (V5.4+) ──────────────────────────────────────────
# Backend: ollama (runtime) ou llamacpp (direct GGUF, recommandé)
LLM_BACKEND=llamacpp
# Modèle (chemin complet pour llamacpp, nom pour ollama)
LLM_MODEL=/path/to/your-model.gguf
# URL du llama-server (si llamacpp)
LLAMACPP_BASE_URL=http://192.168.1.32:8080

# ── Web UI (V5.4+, dev branch) ───────────────────────────
# RADARR_RECO_WEB_PORT: port d'écoute (défaut 8080)
# RADARR_RECO_WEB_HOST: bind address (défaut 127.0.0.1)
# Pour exposer sur le LAN: RADARR_RECO_WEB_HOST=0.0.0.0
# Note: no auth, trusted networks only.
# RADARR_RECO_WEB_PORT=8765
# RADARR_RECO_WEB_HOST=127.0.0.1

# ── Legacy (kept for back-compat with ollama mode) ───────
# Si vous utilisez ollama au lieu de llamacpp, décommentez:
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
