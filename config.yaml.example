# Radarr Movie Recommender - Configuration
# Copy this file to config.yaml and fill in your values

# OMDb API keys (comma-separated)
# Get free keys at https://www.omdbapi.com/apikey.aspx
# Free tier = 1000 requests/day per key - add multiple keys for rotation
omdb_keys: your_key1,your_key2,your_key3

# Radarr settings
# Find your API key in Radarr -> Settings -> General
radarr_api_key: your_radarr_api_key
radarr_url: http://localhost:7878/api/v3
root_folder: "F:\\Movies"

# Quality profile ID to use when adding films to Radarr
# Find your profile IDs in Radarr → Settings → Profiles. The ID is
# in the URL when you click a profile (#profile-{id}) or shown in
# the "Wanted" column. Defaults on a fresh Radarr install:
#   1 = Any
#   2 = SD (deprecated)
#   3 = SD-720p
#   4 = HD-720p
#   5 = HD-1080p (or "HD-720p/1080p" depending on version)
#   6 = Ultra-HD (4K) on newer installs, or HD-720p/1080p on older
# Custom profiles (e.g. "Remux-1080p", "WEB-1080p") get their own
# IDs after creation — check Settings → Profiles to see yours.
quality_profile_id: 6

# Minimum availability before Radarr starts searching
# Options: announced, inCinemas, released, tba
minimum_availability: announced

# LLM backend: 'ollama' (default) or 'llamacpp' (OpenAI-compat /v1 endpoint)
# 'llamacpp' is recommended for users already running llama-server with GGUF.
# Run "ollama pull llama3.1:8b" first if you use 'ollama'.
llm_backend: llamacpp

# Path to the GGUF model (llamacpp) or the model name (ollama)
llm_model: /path/to/your-model.gguf

# URL of the llama-server (only used when llm_backend: llamacpp)
# Must expose /v1/chat/completions. Add --embeddings to llama-server
# for plot-similarity scoring.
llamacpp_base_url: http://your-llama-server-host:8080

# Legacy back-compat: if you use ollama, you can still set this instead
# of llm_model. Kept so older configs keep working.
# ollama_model: llama3.1:8b

# --------------------------------------------------------------------
# Web UI (Vague 5) - only used when you run `python newmovies.py --web`
# --------------------------------------------------------------------
# Priority order: --web-port/--web-host flags > these settings > defaults.
# Binds to 127.0.0.1 by default (no auth, localhost only). Set host to
# 0.0.0.0 to expose on the LAN, but be aware there's no authentication
# — anyone on the network can accept films and add them to Radarr.
web:
  host: 127.0.0.1
  port: 8765
